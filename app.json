{
  "expo": {
    "name": "MatchMyDriver",
    "slug": "matchmydriver-driver",
    "version": "1.2.19",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "matchmydriver",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#3b82f6"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.matchmydriver.driverapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "runtimeVersion": "1.2.19"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#3b82f6"
      },
      "package": "com.matchmydriver.driverapp",
      "googleServicesFile": "./google-services.json",
      "runtimeVersion": "1.2.19",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3b82f6",
          "defaultChannel": "new-rides"
        }
      ],
      "expo-background-fetch",
      "expo-task-manager",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Sta MatchMyDriver toe Face ID te gebruiken voor uw chauffeurssessie."
        }
      ],
      "./plugins/withPrivacyManifest.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "4aead472-356a-46fc-a020-26ed46e8d844"
      }
    }
  }
}
